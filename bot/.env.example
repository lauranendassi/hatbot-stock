# Copiez ce fichier en .env pour les essais en local (ne le mettez JAMAIS sur GitHub).
# Sur Render : mêmes noms dans Environment > Environment Variables.

NOM_MAGASIN=WeloobeAI

# --- Neon (même chaîne que dans config.ini du PC). Vide = mode mémoire (tests).
DATABASE_URL=

# --- Messenger
PAGE_ACCESS_TOKEN=
VERIFY_TOKEN=choisissez_un_mot_secret
APP_SECRET=
GRAPH_VERSION=v26.0
# 1 = n'envoie rien à Messenger, écrit dans les logs (essais)
MESSENGER_DRY_RUN=1

# --- Groq (gratuit)
GROQ_API_KEY=
MODELE_PRINCIPAL=openai/gpt-oss-120b
MODELE_SECOURS=openai/gpt-oss-20b

# --- Rôles : dans Messenger, tapez « /connexion CODE »
CODE_VENDEUR=
CODE_ADMIN=
CODE_BOSS=

# --- Emails (Brevo, gratuit). Martial en copie.
BREVO_API_KEY=
EMAIL_EXPEDITEUR=
EMAIL_DESTINATAIRES=
EMAIL_COPIE=

# --- Divers
MEMOIRE_MESSAGES=30
HANDOFF_HEURES=12
TEST_TOKEN=
LOG_NIVEAU=INFO
